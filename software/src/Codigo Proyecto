const int PIN_TURBIDEZ = 34;

void setup() {
  Serial.begin(115200);

  analogReadResolution(12);

  Serial.println("=== AGUA CLARA - SENSOR ===");
}

void loop() {
  unsigned long suma = 0;

  // Tomar 20 lecturas del sensor
  for (int i = 0; i < 20; i++) {
    suma += analogRead(PIN_TURBIDEZ);
    delay(10);
  }

  // Calcular el promedio
  float raw = suma / 20.0;

  // Mostrar resultado
  Serial.print("RAW: ");
  Serial.println(raw, 0);

  delay(800);
}
